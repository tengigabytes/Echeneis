[Unit]
Description=Echeneis idle CPU load
Documentation=file:///opt/echeneis/CLAUDE.md
After=network.target

[Service]
# Constant ~2% total CPU (1 core at 8% on 4-OCPU ARM), a token baseline
# for tenancies that are not subject to idle-instance reclamation.
# Where reclamation applies (7-day p95 CPU < 20%), use --cpu-load 84
# instead: ~21% total keeps the instance above the threshold at all times.
# Running at the lowest possible priority means real services always win.
Type=simple
ExecStart=/usr/bin/stress-ng --cpu 1 --cpu-load 8 --cpu-method matrixprod --quiet

Nice=19
IOSchedulingClass=idle
CPUSchedulingPolicy=idle

Restart=always
RestartSec=10
StandardOutput=null
StandardError=journal

[Install]
WantedBy=multi-user.target
