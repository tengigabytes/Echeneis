# Echeneis — Environment Variables
# Copy this file to .env and fill in your API keys.

# LiteLLM proxy master key (set your own secret)
LITELLM_MASTER_KEY=sk-change-me

# --- Provider API Keys ---

# Google AI Studio
GOOGLE_AI_STUDIO_API_KEY=

# Mistral
MISTRAL_API_KEY=

# Cerebras
CEREBRAS_API_KEY=

# Groq
GROQ_API_KEY=

# Cloudflare Workers AI
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# GitHub Models
GITHUB_TOKEN=

# OpenRouter
OPENROUTER_API_KEY=

# Google Gemini API
GEMINI_API_KEY=

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=
